# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
# Optional persistent SQLite file path (absolute or relative to backend/).
# Example for a mounted persistent volume: DATABASE_PATH=./data/zyngram.db
DATABASE_PATH=
# Optional persistent employee-document upload root.
# Example for a mounted persistent volume: UPLOADS_DIR=/var/data/uploads
UPLOADS_DIR=
# OpenAI-powered Zynpi assistant. Keep the key on the backend only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email Configuration (SMTP)
# For Gmail, use App Password: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@zyngram.com
